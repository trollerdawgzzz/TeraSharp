<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 8 is the current LTS; matches your Windows Server stack. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Treat warnings as errors keeps the codebase disciplined from day one. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>TeraSharp.Arbiter</AssemblyName>
    <RootNamespace>TeraSharp.Arbiter</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Let the test project see internal builders/helpers. -->
    <InternalsVisibleTo Include="TeraSharp.Arbiter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- T206: the admin UI, compiled in. Flat on purpose - a subdirectory would embed as
         "admin/views\x.js" on Windows and "admin/views/x.js" on Linux, and the same build would
         serve different URLs on the two machines. See Web/AdminAssets.cs. -->
    <EmbeddedResource Include="Web\wwwroot\*.*">
      <LogicalName>admin/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- T199: editable custom policy plus the identical XML as the missing-file fallback. -->
    <Content Include="..\..\data\custom-datasheets\TeraSharpBattlegroundRating.xml"
             Link="custom-datasheets\TeraSharpBattlegroundRating.xml"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\data\custom-datasheets\TeraSharpBattlegroundRating.xml"
                      LogicalName="TeraSharpBattlegroundRating.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Structured logging. Add DB packages (Microsoft.Data.SqlClient / MySqlConnector)
         when we wire persistence. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

</Project>
