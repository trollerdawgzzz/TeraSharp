# TeraSharp — environment. Copy to .env, edit every value, and load it before starting the
# Arbiter. .env is gitignored; .env.example is not. Never put a real secret in this file.
#
# These are read by the process itself, not by a config file. On Windows either set them in
# the service/session that launches the Arbiter, or let deploy.example.ps1 read this file.
# `TeraSharp.Arbiter.exe --check-config` prints what the process actually resolved.
#
# docs/ARCHITECTURE.md section 5 is the authoritative table; this file is that table with
# placeholders in it.

# ---------------------------------------------------------------------------- paths
# Root holding tera-server-proxy\data\data.json, tera_v100_MASTER_FINAL\ and Executable\.
TERASHARP_DATA=C:\path\to\TERA_SERVER.100
# Capture input and the daily arbiter-<date>.log.
TERASHARP_LOGS=C:\path\to\logs
# SQLite file. Defaults to <TERASHARP_LOGS>\terasharp.db. Back it up (tools/backup-db.ps1).
TERASHARP_DB=C:\path\to\logs\terasharp.db

# ---------------------------------------------------------------------------- listener
# Client listener address. LEAVE THIS ON LOOPBACK. The proxy is what faces the internet.
TERASHARP_BIND=127.0.0.1

# ---------------------------------------------------------------------------- auth
# Unset/false = accept any login. Set to true before anyone but you can reach the box.
TERASHARP_AUTH=false
# tera-api's ARBITER API root.
TERASHARP_AUTH_URL=http://127.0.0.1:8080
# Comma-separated accountDBIDs — numbers, not display names.
TERASHARP_GM_ACCOUNTS=
# S_LOGIN_ACCOUNT_INFO.dbServerName. Must match what your tera-api/launcher expects.
TERASHARP_DB_SERVER_NAME=PlanetDB_2800

# ---------------------------------------------------------------------------- admin web
# Unset = the admin web does not start at all. Generate a long random value; do not reuse it.
TERASHARP_ADMIN_TOKEN=
# 8050 is tera-api's own panel — move this off it.
TERASHARP_ADMIN_PORT=8051

# ---------------------------------------------------------------------------- Alt+A gate
# tera-api's gateway API, host:port.
TERASHARP_API_GATEWAY=127.0.0.1:8040
# Set to 1/true to run the probe listener at apiServerAddress.
TERASHARP_API_GATEWAY_SERVE=
# 0.0.0.0, +, or an IP, when the listener must not be loopback-only.
TERASHARP_API_GATEWAY_BIND=
# HS256 key for the Alt+A token — set it to tera-api's API_PORTAL_SECRET.
# Unset means a per-process key, which means Alt+A breaks on every restart.
# THIS IS A SECRET. Put the real one in .env, never here.
TERASHARP_API_JWT_SECRET=

# ---------------------------------------------------------------------------- data blobs
# Required at runtime; see data/README.md for how to produce each one.
TERASHARP_STARTER_BLOB=
TERASHARP_STARTER_INVENTORY=
# Datasheet folder override, checked by --selftest.
TERASHARP_DATASHEET=
# Item names in the admin web. Either an explicit StrSheet_Item*.xml, or a two-column
# templateId<TAB>name file. Both optional.
TERASHARP_ITEM_STRSHEET=
TERASHARP_ITEM_NAMES=

# ---------------------------------------------------------------------------- knobs
# Console verbosity only; the daily file always takes Debug.
TERASHARP_LOG_LEVEL=Warning
# Ranking season number reported to the client.
TERASHARP_RANKING_SEASON=15
# "zone,x,y,z" — forces where a new character starts. Experiment knob, leave unset.
TERASHARP_START_OVERRIDE=
